# Служебное от сборки, в репозитории не нужно.
# fonts/_glyphs.txt — список знаков для подрезки шрифтов. Внутри идёт подряд весь
# цифровой ряд, и PDN-хук читает его как номер документа, блокируя коммит.
# Сам файл пересоздаётся из index.html за секунду, хранить его незачем.
fonts/_glyphs.txt
node_modules/

# Настоящие реквизиты ИП — персональные данные, в репозиторий не попадают.
# В git уходит только шаблон с тегами #INN# и образец requisites.local.json.example.
requisites.local.json
dist/

# Временный прототип светлого тона — материал для решения, не часть сайта.
# Содержит копию боевой шапки с телефоном, поэтому в репозиторий не идёт.
svetlo.html
